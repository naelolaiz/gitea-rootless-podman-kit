# Copy to config.env and edit on each machine. config.env is ignored by git.

POD_NAME="gitea"
CTR_NAME="gitea-server"
IMAGE="docker.gitea.com/gitea:1.26.1-rootless"

# This is the system account that owns/runs rootless Podman for Gitea.
# It is not a personal username. Override it if your machine uses a different account.
PODMAN_USER="git"
PODMAN_GROUP="git"
PODMAN_XDG_RUNTIME_DIR="/run/podman-gitea"

# One machine-local root for all host-side bind-mounted state.
GITEA_BASE_DIR="/srv/gitea"
HOST_DATA_DIR="${GITEA_BASE_DIR}/var/lib/gitea"
HOST_RUNNER_DIR="${GITEA_BASE_DIR}/var/lib/act_runner"
BACKUP_ROOT="${GITEA_BASE_DIR}/backups"

CONFIG_VOLUME="gitea-config"

HTTP_BIND="127.0.0.1"
HTTP_HOST_PORT="3000"
SSH_BIND="127.0.0.1"
SSH_HOST_PORT="2222"

# Fresh install defaults used by scripts/create_fresh_gitea_pod.sh.
# For reverse proxy deployments, FRESH_ROOT_URL should be the public URL.
FRESH_APP_NAME="Gitea"
FRESH_DOMAIN="localhost"
FRESH_SSH_DOMAIN="${FRESH_DOMAIN}"
FRESH_ROOT_URL="http://${HTTP_BIND}:${HTTP_HOST_PORT}/"

# The official rootless Gitea image runs its internal git user as 1000:1000.
# Change these only if you deliberately use a different image/layout.
CONTAINER_GIT_UID="1000"
CONTAINER_GIT_GID="1000"

# Public age recipient. Safe to commit if you want reproducible backups.
# AGE_RECIPIENT="age1..."
# AGE_RECIPIENTS_FILE="./keys/gitea-backup.recipient"

# Private age identity for restore/list operations. Do not commit this file.
# AGE_IDENTITY="/path/to/private/gitea-backup.agekey"

ZSTD_LEVEL="12"
ZSTD_THREADS="0"
ZSTD_LONG="--long=27"
KEEP_DAYS="30"

# Optional private-fork automation for scripts/cron_private_fork_backup.sh.
# Leave PRIVATE_BACKUP_PUSH=0 until the private remote and credentials are tested.
# PRIVATE_BACKUP_GIT_USER defaults to the owner of this bundle directory.
# PRIVATE_BACKUP_GIT_USER="your-login-user"
# PRIVATE_BACKUP_GIT_GROUP="your-login-group"
PRIVATE_BACKUP_PUSH="0"
PRIVATE_BACKUP_GIT_REMOTE="origin"
PRIVATE_BACKUP_GIT_BRANCH="main"
PRIVATE_BACKUP_COMMIT_PREFIX="Automated encrypted Gitea backup"
PRIVATE_BACKUP_REQUIRE_CLEAN="1"
PRIVATE_BACKUP_KEEP_REPO_BACKUPS="0"
